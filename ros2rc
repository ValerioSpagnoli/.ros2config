CURRENT_SHELL=$(basename $SHELL)
USER_NAME=$(whoami)
ROS_WS=~/ros2_ws

#| Enable Multicast on LoopBack interface |#
LO_MULTICAST=0
if [[ $(ip l show lo | grep MULTICAST) ]]; then
    LO_MULTICAST=1
fi

#| Source ROS2 and uROS setup files |#
source /opt/ros/$(ls /opt/ros/)/setup.$CURRENT_SHELL
if [ -d $ROS_WS/install ]; then
    source $ROS_WS/install/local_setup.$CURRENT_SHELL
fi

#| Aliases |#
alias ros2rcNano="nano ~/.ros2config/ros2rc"
alias ros2rcGedit="gedit ~/.ros2config/ros2rc"
alias ros2rcCode="code ~/.ros2config/ros2rc"
alias ros2rcSource="source ~/.ros2config/ros2rc"
alias ros2help="ros2help"
alias ros2conf="ros2conf"

alias ros2build="ros2build"
alias ros2source="ros2source"
alias ros2sourceGlobal="ros2sourceGlobal"
alias ros2sourceLocal="ros2sourceLocal"
alias ros2clean="ros2clean"
alias ros2domain="ros2domain"
alias ros2dds="ros2dds"
alias ros2lh="ros2lh"

alias foxglove-bridge="ros2 launch foxglove_bridge foxglove_bridge_launch.xml send_buffer_limit:=300000000"
alias teleop="ros2 run teleop_twist_keyboard teleop_twist_keyboard"
alias tf2="tf2" 

#| Environment variables |#
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI=$ROS_WS/dds_config/cyclone_dds_config.xml
export FASTRTPS_DEFAULT_PROFILES_FILE=$ROS_WS/dds_config/fast_rtps_dds_config.xml
export ROS_DOMAIN_ID=1
export ROS_LOCALHOST_ONLY=0
export MAKEFLAGS=-j$(nproc)
FAST_DDS="rmw_fastrtps_cpp"
CYCLONE_DDS="rmw_cyclonedds_cpp"
ZENOH_DDS="rmw_zenoh_cpp"

#| Functions |#
function ros2build() {
    CURRENT_DIR=$(pwd)
    cd $ROS_WS

    # Default values
    SEQUENTIAL=false
    PARALLEL_WORKERS=""
    JOBS=""
    PACKAGES=()
    PACKAGES_EXCLUDE=()
    RELEASE=true

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            -s|--seq)
                SEQUENTIAL=true
                shift
                ;;
            -w|--workers)
                PARALLEL_WORKERS="$2"
                shift 2
                ;;
            -j|--jobs)
                JOBS="$2"
                shift 2
                ;;
            -p|--pkg)
                IFS=',' read -ra PKG_ARRAY <<< "$2"
                PACKAGES+=("${PKG_ARRAY[@]}")
                shift 2
                ;;
            -r|--release)
                if [ "$2" = "0" ]; then
                    RELEASE=false
                fi
                shift 2
                ;;
            -e|--exclude)
                IFS=',' read -ra EXCLUDE_ARRAY <<< "$2"
                for pkg in "${EXCLUDE_ARRAY[@]}"; do
                    PACKAGES_EXCLUDE+=("$pkg")
                done
                shift 2
                ;;
            -h|--help)
                echo "Usage: ros2build [-s|--seq] [-w <num>|--workers <num>] [-j <num>|--jobs <num>] [-p <pkg1,pkg2,...>|--pkg <pkg1,pkg2,...>] [-r <0|1>|--release <0|1>]"
                echo " -s|--seq: to build one package at time (sequentially)"
                echo " -w|--workers: to specify the number of workers for parallel build"
                echo " -j|--jobs: to specify the number of jobs (cores) used to build"
                echo " -p|--pkg: to specify which package(s) to build (comma-separated for multiple)"
                echo " -r|--release: set to 0 to disable Release build type (enabled by default)"
                echo " -e|--exclude: to exclude specific package(s) from the build (comma-separated for multiple)"
                echo "Flags can be used in combination."
                cd $CURRENT_DIR
                return
                ;;
            *)
                echo "Unknown option: $1"
                cd $CURRENT_DIR
                return 1
                ;;
        esac
    done

    # Construct build command
    BUILD_CMD="colcon build --symlink-install"
    
    if [ "$SEQUENTIAL" = true ]; then
        BUILD_CMD+=" --executor sequential"
    fi
    
    if [ -n "$PARALLEL_WORKERS" ]; then
        BUILD_CMD+=" --parallel-workers $PARALLEL_WORKERS"
    fi
    
    if [ ${#PACKAGES[@]} -gt 0 ]; then
        BUILD_CMD+=" --packages-select ${PACKAGES[*]}"
    fi

    if [ ${#PACKAGES_EXCLUDE[@]} -gt 0 ]; then
        BUILD_CMD+=" --packages-skip ${PACKAGES_EXCLUDE[*]}"
    fi

    if [ "$RELEASE" = true ]; then
        BUILD_CMD+=" --cmake-args -DCMAKE_BUILD_TYPE=Release"
    fi
    
    if [ -n "$JOBS" ]; then
        BUILD_CMD="MAKEFLAGS=\"-j $JOBS\" $BUILD_CMD"
        echo "Building with MAKEFLAGS=\"-j $JOBS\""
    fi

    echo "Starting build with the following command: $BUILD_CMD"

    # Execute build command
    eval $BUILD_CMD

    # Source the setup file
    source install/local_setup.$CURRENT_SHELL

    cd $CURRENT_DIR
}

function ros2sourceGlobal() {
    source /opt/ros/$ROS_DISTRO/setup.$CURRENT_SHELL
}

function ros2sourceLocal() {
    source $ROS_WS/install/local_setup.$CURRENT_SHELL
}

function ros2source(){
    ros2sourceGlobal
    ros2sourceLocal
}

function ros2clean() {
    CURRENT_DIR=$(pwd)

    cd $ROS_WS
    case $1 in
        -a|--all) 
            rm -rf $ROS_WS/build $ROS_WS/install $ROS_WS/log
            export AMENT_PREFIX_PATH=''
            export CMAKE_PREFIX_PATH=''
            export COLCON_PREFIX_PATH=''
            echo "Workspace cleaned";;
        -p|--pkg) 
            rm -rf $ROS_WS/build/$2 $ROS_WS/install/$2 $ROS_WS/log/$2
            export AMENT_PREFIX_PATH=$(echo $AMENT_PREFIX_PATH | sed "s|$ROS_WS/install/$2:||g")
            echo "Package $2 cleaned";;
        -h|--help)
            echo "Usage: ros2clean [-p <pkg>|--pkg <pkg>]"
            echo "  -a|--all: to clean the entire workspace"
            echo "  -p|--pkg: to clean a specific package"
            echo "Only one flag can be used.";;
        *)
    esac
    cd $CURRENT_DIR

    ros2sourceGlobal
    if [ -d $ROS_WS/install ]; then
        ros2sourceLocal
    fi
}

function ros2domain() {
    # Function to check if the input is a valid number
    is_valid_domain_id() {
        [[ $1 =~ ^[0-9]+$ ]] && [ $1 -ge 0 ] && [ $1 -le 232 ]
    }

    case $1 in
        -p|--perm) 
            if is_valid_domain_id "$2"; then
                sed -i "s/ROS_DOMAIN_ID=$ROS_DOMAIN_ID/ROS_DOMAIN_ID=$2/g" ~/.ros2config/ros2rc && ros2rcSource
                echo "ROS_DOMAIN_ID permanently set to $2"
            else
                echo "Error: $2 is not a valid number. Please provide a number between 0 and 232."
            fi
            ;;
        -t|--temp) 
            if is_valid_domain_id "$2"; then
                export ROS_DOMAIN_ID=$2
                echo "ROS_DOMAIN_ID temporarily set to $2"
            else
                echo "Error: $2 is not a valid number. Please provide a number between 0 and 232."
            fi
            ;;
        -h|--help) 
            echo "Usage: ros2domain [-p <num>|--perm <num>] [-t <num>|--temp <num>]"
            echo "  -p|--perm: to set the domain id permanently"
            echo "  -t|--temp: to set the domain id temporarily"
            echo "Only one flag can be used."
            ;;
        *) echo "ROS_DOMAIN_ID=$ROS_DOMAIN_ID";;
    esac
}

function ros2dds() {
    case $1 in
        -c|--cyclone) 
            sed -i "s/RMW_IMPLEMENTATION=$RMW_IMPLEMENTATION/RMW_IMPLEMENTATION=$CYCLONE_DDS/g" ~/.ros2config/ros2rc && ros2rcSource
            echo "DDS implementation set to $CYCLONE_DDS";;
        -f|--fastrtps) 
            sed -i "s/RMW_IMPLEMENTATION=$RMW_IMPLEMENTATION/RMW_IMPLEMENTATION=$FAST_DDS/g" ~/.ros2config/ros2rc && ros2rcSource
            echo "DDS implementation set to $FAST_DDS";;
        -z|--zenoh)
            sed -i "s/RMW_IMPLEMENTATION=$RMW_IMPLEMENTATION/RMW_IMPLEMENTATION=$ZENOH_DDS/g" ~/.ros2config/ros2rc && ros2rcSource
            echo "DDS implementation set to $ZENOH_DDS";;
        -h|--help)
            echo "Usage: ros2dds [-c|--cyclone] [-f|--fastrtps]"
            echo "  -c|--cyclone: to set the DDS implementation to Cyclone DDS"
            echo "  -f|--fastrtps: to set the DDS implementation to FastRTPS DDS"
            echo "Only one flag can be used.";;
        *) echo "DDS implementation: $RMW_IMPLEMENTATION";;
    esac
}

function ros2lh(){
    ROS_LOCALHOST_ONLY_ENABLED=1
    ROS_LOCALHOST_ONLY_DISABLED=0
    RMW_IMPLEMENTATION=$(printenv RMW_IMPLEMENTATION)
    
    case $1 in
        -e|--enable) 
            sed -i "s/ROS_LOCALHOST_ONLY=$ROS_LOCALHOST_ONLY/ROS_LOCALHOST_ONLY=$ROS_LOCALHOST_ONLY_ENABLED/g" ~/.ros2config/ros2rc && sudo -S ip l set lo multicast on && ros2rcSource
            echo "ROS_LOCALHOST_ONLY enabled";;
        -d|--disable) 
            sed -i "s/ROS_LOCALHOST_ONLY=$ROS_LOCALHOST_ONLY/ROS_LOCALHOST_ONLY=$ROS_LOCALHOST_ONLY_DISABLED/g" ~/.ros2config/ros2rc && sudo -S ip l set lo multicast off && ros2rcSource
            echo "ROS_LOCALHOST_ONLY disabled";;
        -h|--help) 
            echo "Usage: ros2lh [-e|--enable] [-d|--disable]"
            echo "  -e|--enable: to enable the ROS_LOCALHOST_ONLY"
            echo "  -d|--disable: to disable the ROS_LOCALHOST_ONLY"
            echo "Only one flag can be used.";;
        *) echo "ROS_LOCALHOST_ONLY: $ROS_LOCALHOST_ONLY";;
    esac
}

function tf2(){
    TIME=2
    if [ $1 = "-t" ]; then
        TIME=$2
    fi

    echo "Generating tf2 frames:"
    echo "  - Time: $TIME"
    echo "  - Output: $ROS_WS/frames.pdf"

    ros2 run tf2_tools view_frames -t $TIME -o $ROS_WS/frames
    evince $ROS_WS/frames.pdf
}

function ros2hz() {
    # Help message function
    show_help() {
        echo "Usage: ros2hz <topic> [-w <win_size>] [-n <node_name>]"
        echo
        echo "Run topic hz from Stereolabs for ROS2 topics."
        echo
        echo "Arguments:"
        echo "  <topic>              The ROS2 topic to monitor (required)"
        echo
        echo "Options:"
        echo "  -w <win_size>        Set the average window size"
        echo "  -n <node_name>       Set a custom node name (default: derived from topic)"
        echo "  -h, --help           Display this help message"
        echo
        echo "Examples:"
        echo "  ros2hz /camera/image_raw"
        echo "  ros2hz /camera/image_raw -w 100"
        echo "  ros2hz /camera/image_raw -w 100 -n my_custom_node"
    }

    # Check if at least one argument (topic name) is provided
    if [ $# -eq 0 ]; then
        echo "Error: Topic name is required."
        echo "Use 'ros2hz -h' or 'ros2hz --help' for usage information."
        return 1
    fi

    # Set default values
    topic=""
    win_size=""
    node_name=""

    while [[ $# -gt 0 ]]; do
        case $1 in 
            -w | --win_size)
                echo "win_size is $2"
                win_size=$2
                shift 2
                ;;
            -n | --node_name)
                node_name=$(echo "$2" | tr '/' '_')
                shift 2
                ;;
            -h | --help)
                show_help
                return 0
                ;;
            *)
                topic=$1
                # Remove the first '/' and replace all remaining '/' with '_' for the default node name
                node_name=$(echo "${topic#/}" | tr '/' '_')
                echo "Starting HZ tool on topic: $topic"
                shift 1
                ;;
        esac
    done

    #if topic argument not set 
    if [ -z "$topic" ]; then
        echo "Error: Topic name is required."
        echo "Use 'ros2hz -h' or 'ros2hz --help' for usage information."
        return 1
    fi

    # Construct the command
    cmd="ros2 run zed_topic_benchmark zed_topic_benchmark --ros-args -p topic_name:=$topic"

    # Add win_size if provided
    if [ -n "$win_size" ]; then
        cmd="$cmd -p avg_win_size:=$win_size"
    fi

    # Add node name
    if [ -n "$node_name" ]; then
        cmd="$cmd -r __node:=$node_name -r __ns:=/hz"
    fi

    # Execute the command
    echo "command is $cmd"
    eval $cmd
}

function ros2rc() {

    show_help() {
        echo "Usage: ros2rc [options]"
        echo
        echo "Options:"
        echo "  -h, --help           Show this help message and exit"
        echo "  -s, --source         Source the ros2rc file"
        echo "  -n, --nano           Edit the ros2rc file with nano"
        echo "  -g, --gedit          Edit the ros2rc file with gedit"
        echo "  -c, --code           Edit the ros2rc file with VSCode"
        echo
    }

    while [[ $# -gt 0 ]]; do
        case $1 in
            -h|--help)
                show_help
                return 0
                ;;
            -s|--source)
                ros2rcSource
                return 0
                ;;
            -n|--nano)
                ros2rcNano
                return 0
                ;;
            -g|--gedit)
                ros2rcGedit
                return 0
                ;;
            -c|--code) 
                ros2rcCode
                return 0
                ;;
            *)
                echo "Unknown option: $1"
                return 1
                ;;
        esac
    done
}

